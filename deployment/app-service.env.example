# Set in App Service > Environment variables, not in source control as real values.
NODE_ENV=production
HOST=0.0.0.0
# App Service provides PORT; do not override it.
DATABASE_URL=postgresql://divyashilla_runtime:ENCODED_PASSWORD@SERVER.postgres.database.azure.com:5432/divyashilla
PG_SSL=true
CSRF_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
ALLOWED_ORIGINS=https://YOUR_APP.azurewebsites.net
SESSION_HOURS=12
ENABLE_CONTAINS_SEARCH=true
TRUST_PROXY_HOPS=1
FILES_DRIVER=azure
AZURE_STORAGE_ACCOUNT=YOUR_STORAGE_ACCOUNT
AZURE_STORAGE_CONTAINER=private-files
FRONTEND_DIRECTORY=./public
# Do not put MIGRATION_DATABASE_URL in the running app.
# Built release: no remote build, package already includes runtime node_modules.
SCM_DO_BUILD_DURING_DEPLOYMENT=false
